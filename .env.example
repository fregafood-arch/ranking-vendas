# Copie este arquivo para .env.local e preencha com as chaves do seu projeto
# Supabase (Project Settings > API no painel do Supabase).

# URL pública do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon" (pública) — respeita RLS, segura para expor no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — ignora RLS. NUNCA prefixar com NEXT_PUBLIC_, nunca
# importar em componente "use client" nem em qualquer código que vá para o
# bundle do navegador. Usada apenas em lib/supabase/admin.ts, server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Conta de serviço do Modo TV (ETAPA 9): um usuário criado no Supabase Auth
# (Authentication > Users > Add user), papel VISUALIZACAO. A rota /tv
# autentica com essas credenciais no servidor para ler os dados sem exigir
# login de quem está olhando a TV — ver lib/supabase/tv.ts.
TV_SERVICE_ACCOUNT_EMAIL=
TV_SERVICE_ACCOUNT_PASSWORD=
